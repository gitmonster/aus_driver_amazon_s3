			<trans-unit id="driverConfiguration.signature.auto">
				<source>auto</source>
			</trans-unit>
			<trans-unit id="driverConfiguration.caseSensitive">
				<source>Case sensitive file system?</source>
			</trans-unit>
			<trans-unit id="driverConfiguration.message.connectionTestFailed.title">
				<source>AWS S3 connection failed</source>
			</trans-unit>
			<trans-unit id="driverConfiguration.message.connectionTestSuccessful.title">
				<source>Connection successful</source>
			</trans-unit>
			<trans-unit id="driverConfiguration.message.connectionTestSuccessful.message">
