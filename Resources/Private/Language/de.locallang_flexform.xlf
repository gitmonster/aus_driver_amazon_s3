			<trans-unit id="driverConfiguration.cacheHeaderDuration">
				<target>Cache Header: Max-Age (in Sekunden, optional)</target>
			</trans-unit>
			<trans-unit id="driverConfiguration.protocol">
				<target>Netzwerkprotokoll</target>
